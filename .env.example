# ── Database (Neon / PostgreSQL) ──────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host.neon.tech/db?sslmode=require"

# ── NextAuth ──────────────────────────────────────────────────────────────────
AUTH_SECRET="run: npx auth secret"
NEXTAUTH_URL="http://localhost:3000"

# ── Cloudinary (image uploads) ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Admin (seeds first admin — run: npx prisma db seed) ───────────────────────
ADMIN_EMAIL="admin@tannifashionhouse.com"
ADMIN_PHONE="01700000000"
ADMIN_PASSWORD="change_this_strong_password"

# ── SMTP (order confirmation emails — Gmail App Password) ─────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="yourstore@gmail.com"
SMTP_PASS="16_char_gmail_app_password"
SMTP_FROM="Tanni Fashion House <yourstore@gmail.com>"
ADMIN_NOTIFY_EMAIL="yourstore@gmail.com"
